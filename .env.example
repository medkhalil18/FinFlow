# Local or hosted PostgreSQL / Supabase Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Required in production for auth session signing
JWT_SECRET=replace-with-a-long-random-secret

# Optional: force SSL on hosted databases like Supabase
# Set to true for Supabase/Vercel deployments if needed
DATABASE_SSL=true
